[gd_resource type="Resource" script_class="TenantApplication" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/tenants/tenant_application.gd" id="1_app"]
[ext_resource type="Script" path="res://scripts/tenants/tenant_resident.gd" id="2_res"]
[ext_resource type="Script" path="res://scripts/tenants/application_line.gd" id="3_line"]

[sub_resource type="Resource" id="res_petra"]
script = ExtResource("2_res")
id = &"petra"
display_name = "Petra"
body = "adult"

[sub_resource type="Resource" id="res_jonas"]
script = ExtResource("2_res")
id = &"jonas"
display_name = "Jonas"
body = "adult"

[sub_resource type="Resource" id="res_mia"]
script = ExtResource("2_res")
id = &"mia"
display_name = "Mia"
body = "child"

[sub_resource type="Resource" id="res_ben"]
script = ExtResource("2_res")
id = &"ben"
display_name = "Ben"
body = "child"

[sub_resource type="Resource" id="line_1"]
script = ExtResource("3_line")
text = "Four of us need somewhere to sleep. We have done the sums."
requirement = "need:sleep"
speaker = &"petra"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("3_line")
text = "Somewhere we can all sit down at once, now and then."
requirement = "need:sit"
speaker = &"jonas"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("3_line")
text = "And a place for my toys that Ben can't reach."
requirement = "need:storage"
speaker = &"mia"

[resource]
script = ExtResource("1_app")
level_id = "rental:family"
residents = Array[ExtResource("2_res")]([SubResource("res_petra"), SubResource("res_jonas"), SubResource("res_mia"), SubResource("res_ben")])
lines = Array[ExtResource("3_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3")])
