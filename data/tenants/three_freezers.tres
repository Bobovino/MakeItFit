[gd_resource type="Resource" script_class="TenantApplication" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/tenants/tenant_application.gd" id="1_app"]
[ext_resource type="Script" path="res://scripts/tenants/tenant_resident.gd" id="2_res"]
[ext_resource type="Script" path="res://scripts/tenants/application_line.gd" id="3_line"]

[sub_resource type="Resource" id="res_dani"]
script = ExtResource("2_res")
id = &"dani"
display_name = "Dani"
body = "adult"

[sub_resource type="Resource" id="line_1"]
script = ExtResource("3_line")
text = "The freezers come with me. All three. This is not up for discussion."
requirement = "need:storage"
speaker = &"dani"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("3_line")
text = "I stream twelve hours a day, so I need a real desk. The floor is not a desk."
requirement = "need:work"
speaker = &"dani"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("3_line")
text = "And a chair. My back has opinions."
requirement = "need:sit"
speaker = &"dani"

[sub_resource type="Resource" id="line_4"]
script = ExtResource("3_line")
text = "Somewhere to sleep. Up high is fine. Up high is actually cool."
requirement = "need:sleep"
speaker = &"dani"

[sub_resource type="Resource" id="line_5"]
script = ExtResource("3_line")
text = "A working bathroom, for the four minutes a day I'm not live."
requirement = "need:hygiene"
speaker = &"dani"

[resource]
script = ExtResource("1_app")
level_id = "three_freezers"
residents = Array[ExtResource("2_res")]([SubResource("res_dani")])
lines = Array[ExtResource("3_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3"), SubResource("line_4"), SubResource("line_5")])
