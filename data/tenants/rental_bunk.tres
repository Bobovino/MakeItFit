[gd_resource type="Resource" script_class="TenantApplication" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/tenants/tenant_application.gd" id="1_app"]
[ext_resource type="Script" path="res://scripts/tenants/tenant_resident.gd" id="2_res"]
[ext_resource type="Script" path="res://scripts/tenants/application_line.gd" id="3_line"]

[sub_resource type="Resource" id="res_sven"]
script = ExtResource("2_res")
id = &"sven"
display_name = "Sven"
body = "adult"

[sub_resource type="Resource" id="res_aiko"]
script = ExtResource("2_res")
id = &"aiko"
display_name = "Aiko"
body = "adult"

[sub_resource type="Resource" id="res_mateo"]
script = ExtResource("2_res")
id = &"mateo"
display_name = "Mateo"
body = "adult"

[sub_resource type="Resource" id="line_1"]
script = ExtResource("3_line")
text = "Three beds. Stacked is fine, we're used to it."
requirement = "need:sleep"
speaker = &"sven"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("3_line")
text = "Somewhere to sit and plan tomorrow's route."
requirement = "need:sit"
speaker = &"aiko"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("3_line")
text = "Somewhere for the backpacks that isn't the beds."
requirement = "need:storage"
speaker = &"mateo"

[resource]
script = ExtResource("1_app")
level_id = "rental:bunk"
residents = Array[ExtResource("2_res")]([SubResource("res_sven"), SubResource("res_aiko"), SubResource("res_mateo")])
lines = Array[ExtResource("3_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3")])
