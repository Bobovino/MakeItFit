[gd_resource type="Resource" script_class="TenantApplication" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/tenants/tenant_application.gd" id="1_app"]
[ext_resource type="Script" path="res://scripts/tenants/tenant_resident.gd" id="2_res"]
[ext_resource type="Script" path="res://scripts/tenants/application_line.gd" id="3_line"]

[sub_resource type="Resource" id="res_guillem"]
script = ExtResource("2_res")
id = &"guillem"
display_name = "Sir Guillem"
body = "adult"
look = "masc"

[sub_resource type="Resource" id="line_1"]
script = ExtResource("3_line")
text = "A knight sleeps at the top of his tower. Or at least somewhere in it."
requirement = "need:sleep"
speaker = &"guillem"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("3_line")
text = "A kitchen, for I intend to roast things."
requirement = "need:cook"
speaker = &"guillem"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("3_line")
text = "A desk, from which to write strongly worded letters to the council."
requirement = "need:work"
speaker = &"guillem"

[sub_resource type="Resource" id="line_4"]
script = ExtResource("3_line")
text = "A seat. My knees have climbed enough stairs for one lifetime."
requirement = "need:sit"
speaker = &"guillem"

[sub_resource type="Resource" id="line_5"]
script = ExtResource("3_line")
text = "Somewhere to keep my armour. It is mostly decorative."
requirement = "need:storage"
speaker = &"guillem"

[sub_resource type="Resource" id="line_6"]
script = ExtResource("3_line")
text = "And a privy. A modern one, if it please you."
requirement = "need:hygiene"
speaker = &"guillem"

[resource]
script = ExtResource("1_app")
level_id = "the_tower"
residents = Array[ExtResource("2_res")]([SubResource("res_guillem")])
lines = Array[ExtResource("3_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3"), SubResource("line_4"), SubResource("line_5"), SubResource("line_6")])
